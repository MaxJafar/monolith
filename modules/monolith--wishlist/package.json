    "@monolith/server-utils": "workspace:*",
    "@monolith/ui": "workspace:*"
  },
  "author": "Monolith contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaxJafar/monolith.git",
    "directory": "modules/monolith--wishlist"
  },
  "monolith": {
    "icon": "tabler:gift",
    "category": "Lifestyle",
    "id": "monolith--wishlist",
    "routeId": "f45a780c57b2507856827e7b41cf5c7a48444004fc24c281071d281af0d79ec8"
  },
  "monolithBuilds": {
    "build": "pnpm run build:client && pnpm run build:server",
