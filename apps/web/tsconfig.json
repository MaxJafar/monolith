{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable",
      "ES2022.Error",
      "ES2022.Array",
      "ES2024.Object"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "outDir": "${configDir}/tsbuild",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "composite": true,
    "rootDir": "../../",
    "paths": {
      "@/*": ["./src/*"],
      "@core/*": ["../../core/*"]
    }
  },
  "include": [
    "../../package.json",
    "./src/**/*",
    "./vite.config.ts",
    "./contract.ts",
    "../../packages/api/package.json",
    "../../packages/ui/package.json",
    "../../packages/federation/package.json",
    "../../packages/localization/package.json",
    "../../modules/monolith--databases/client/contract.ts",
    "../../modules/monolith--databases/navigationShared.ts",
    "../../modules/monolith--databases/client/src/utils/systemViews.ts",
    "../../modules/monolith--databases/shared.ts",
    "../../modules/monolith--databases/urpgShared.ts",
    "../../modules/monolith--databases/widgetShared.ts"
  ]
}
