{
  "name": "@monolith/tech-lab",
  "displayName": "Tech Lab",
  "version": "0.0.3",
  "type": "module",
  "author": "Monolith contributors",
  "description": "Native devices, hosted services, game servers and observed health.",
  "scripts": {
    "build": "node \"../../tools/build-guard.mjs\" --task build",
    "build:client": "node \"../../tools/build-guard.mjs\" --task build:client",
    "build:server": "node \"../../tools/build-guard.mjs\" --task build:server",
    "typecheck": "pnpm run typecheck:client && pnpm run typecheck:server",
    "typecheck:client": "tsc -p client/tsconfig.json",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "test": "vitest run server/*.test.ts importer.test.ts client/src/utils/*.test.ts"
  },
  "peerDependencies": {
    "@monolith/api": "workspace:*",
    "@monolith/blocks": "workspace:*",
    "@monolith/configs": "workspace:*",
    "@monolith/drizzle": "workspace:*",
    "@monolith/federation": "workspace:*",
    "@monolith/localization": "workspace:*",
    "@monolith/server-utils": "workspace:*",
    "@monolith/ui": "workspace:*"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "postgres": "^3.4.9"
  },
  "monolith": {
    "icon": "tabler:server",
    "category": "Utilities",
    "id": "monolith--tech-lab",
    "routeId": "16c150ed5ddce9392bf76bf6966e6144b1045eec7712641c5c8ba3ac29fd3c40",
    "experience": {
      "kind": "dashboard",
      "surfaces": [
        "dashboard",
        "widget"
      ]
    }
  },
  "monolithBuilds": {
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "vite build --config server/vite.config.ts"
  },
  "license": "0BSD"
}
