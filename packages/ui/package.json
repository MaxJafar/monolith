  "description": "Monolith UI component library",
  "license": "0BSD",
  "author": "Monolith contributors",
  "maintainers": [
    "Monolith contributors"
  ],
  "keywords": [
    "ui",
    "components",
    "react",
    "monolith"
  ],
  "sideEffects": [
