{
  "name": "@monolith/drizzle",
  "version": "0.0.1",
  "description": "Drizzle ORM glue for the Monolith server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@monolith/module-runtime": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@monolith/configs": "workspace:*",
    "@types/node": "^25.0.6"
  },
  "author": "Monolith contributors"
}
