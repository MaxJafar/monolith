# CLIENT

VITE_API_HOST=http://localhost:3636

# SERVER

DATABASE_URL=
# Schema management only; DATABASE_URL must use a nonsuperuser without BYPASSRLS.
DATABASE_ADMIN_URL=
MASTER_KEY=
JWT_SIGNING_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173

PORT=3636

# Shared Mac mini AI. The loopback URL reaches the host through pinned SSH over Tailscale.
SHARED_AI_URL=http://127.0.0.1:8771
SHARED_AI_TOKEN_FILE=
SHARED_AI_EMBEDDING_MODEL=monolith-embeddinggemma
SHARED_AI_GENERATION_MODEL=monolith-gemma
# Bump when replacing model weights under the same alias to rebuild search vectors.
SHARED_AI_INDEX_VERSION=1

# Optional self-hosted GitHub addon/locale index; blank disables registry operations.
MONOLITH_REGISTRY_REPO=
MONOLITH_REGISTRY_REF=main

# Runtime Addons and Widgets shop. Blank catalog disables downloads.
MONOLITH_ADDON_CATALOG_URL=
MONOLITH_ADDON_CATALOG_PUBLIC_KEY=
MONOLITH_ADDON_ADMIN_IDS=
# Host-controlled local catalog (development/offline only).
MONOLITH_ADDON_CATALOG_FILE=
# Set only after applying the matching host database migration.
MONOLITH_ADDON_SCHEMA_FILE=
# Default preserves source modules in a developer checkout; 1 loads only core + managed addons.
MONOLITH_CORE_ONLY=0

# Independent host updater. Keep its authentication token server-side.
MONOLITH_UPDATER_URL=
MONOLITH_UPDATER_TOKEN=
MONOLITH_UPDATE_ADMIN_IDS=

# Optional calendar email delivery. These are API-server secrets/settings only.
# In-app calendar notifications work without these values. See docs/CALENDAR.md.
MONOLITH_RESEND_API_KEY=
MONOLITH_EMAIL_FROM=
MONOLITH_PUBLIC_URL=
