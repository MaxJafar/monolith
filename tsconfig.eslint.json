{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "modules/**/*",
    "packages/**/*",
    "apps/web/**/*",
    "apps/api/**/*",
    "docs/**/*",
    "scripts/**/*",
    "tools/**/*",
    ".pnpmfile.cjs",
    "eslint.config.js",
    "packages/ui/.storybook/**/*",
    "eslint/**/*.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/dist-docker", "**/tsbuild"]
}
