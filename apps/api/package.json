{
  "name": "@monolith/server",
  "private": true,
  "description": "Monolith workspace API",
  "version": "0.1.2",
  "license": "CC BY-NC-SA 4.0",
  "author": "Monolith contributors",
  "homepage": "https://github.com/MaxJafar/monolith",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaxJafar/monolith.git",
    "directory": "apps/api"
  },
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "node \"../../tools/build-guard.mjs\" --task build",
    "start": "tsc -b && cross-env NODE_ENV=production tsx ./src/index.ts",
    "start:prod": "cross-env NODE_ENV=production node --env-file=../../env/.env.local ./dist/server.js",
    "start:watch": "cross-env NODE_ENV=production node --watch --env-file=../../env/.env.local ./dist/server.js",
    "dev": "tsx watch --clear-screen=false ./src/index.ts",
    "lint": "eslint ./src --fix && prettier --write ./src",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "typecheck": "tsc -b",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@monolith/configs": "workspace:*",
    "@monolith/drizzle": "workspace:*",
    "@monolith/file-storage": "workspace:*",
    "@monolith/log": "workspace:*",
    "@monolith/module-runtime": "workspace:*",
    "@monolith/server-utils": "workspace:*",
    "@types/multer": "^2.2.0",
    "@typescript/typescript6": "^6.0.2",
    "arctic": "^3.7.0",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.2",
    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "commander": "^15.0.0",
    "content-disposition": "^3.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "ipaddr.js": "2.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "openai": "^6.7.0",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^6.4.299",
    "postgres": "^3.4.9",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@monolith/api": "workspace:*",
    "@monolith/blocks": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.23",
    "@types/express-serve-static-core": "4.19.6",
    "@types/jsdom": "^28.0.3",
    "@types/speakeasy": "^2.0.10",
    "@vitest/ui": "^4.0.2",
    "axios": "^1.18.1"
  },
  "monolithBuilds": {
    "build": "tsc -b && vite build"
  }
}
