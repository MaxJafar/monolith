# Deploy on your own public relay host; replace domain, secret and TLS paths.
# API: ROOMS_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# API: ROOMS_TURN_SECRET must equal static-auth-secret (at least 32 random characters).
listening-port=3478
tls-listening-port=5349
min-port=49160
max-port=49260
realm=turn.example.com
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET
cert=/etc/monolith/turn/fullchain.pem
pkey=/etc/monolith/turn/privkey.pem
# If behind one-to-one NAT, set external-ip=PUBLIC_IP/PRIVATE_IP.
no-cli
no-tcp-relay
no-multicast-peers
stale-nonce=600
user-quota=24
total-quota=1200
# Prevent relayed traffic from reaching private infrastructure.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=ff00::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
