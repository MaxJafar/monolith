{
  "extends": "@monolith/configs/tsconfig/module.json",
  "compilerOptions": {
    "rootDir": "..",
    "paths": {
      "@/manifest": ["./manifest.ts"],
      "@": ["./src/index"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "./src/**/*",
    "./manifest.ts",
    "./vite.config.ts",
    "./contract.ts",
    "../shared.ts",
    "../computed.ts",
    "../progress.ts",
    "../workspaceShared.ts",
    "../navigationShared.ts",
    "../knowledgeLibraryShared.ts"
  ]
}
