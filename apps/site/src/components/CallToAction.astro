---
import Icon from './Icon.astro'
---

<section class="closing container">
  <img src="/icon.svg" width="56" height="56" alt="Monolith" loading="lazy" />
  <h2>
    A little more space.
    <br />
    <span>A lot more possibility.</span>
  </h2>
  <p>Start with the essentials. Make the rest your own.</p>
  <div class="button-row">
    <a class="button primary" href="/docs/installation">
      Make yourself at home <Icon name="arrow" size={18} />
    </a>
    <a class="button secondary" href="/docs">
      Explore the docs <Icon name="book" size={18} />
    </a>
  </div>
</section>
