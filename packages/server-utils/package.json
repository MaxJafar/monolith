{
  "name": "@monolith/server-utils",
  "version": "0.0.1",
  "description": "Server SDK for Monolith modules",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node \"../../tools/build-guard.mjs\" --task build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --emitDeclarationOnly"
  },
  "dependencies": {
    "@monolith/blocks": "workspace:*",
    "@monolith/configs": "workspace:*",
    "@monolith/drizzle": "workspace:*",
    "@monolith/file-storage": "workspace:*",
    "@monolith/log": "workspace:*",
    "@monolith/module-runtime": "workspace:*",
    "chalk": "^5.6.2",
    "crypto-js": "^4.2.0",
    "express": "^4.21.2",
    "form-data": "^4.0.0",
    "groq-sdk": "^0.20.0",
    "ical.js": "^2.1.0",
    "openai": "^4.81.0",
    "pdf2pic": "^3.1.5",
    "prettier": "^3.9.5",
    "socket.io": "^4.8.3",
    "tesseract.js": "^5.1.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.23",
    "@types/express-serve-static-core": "4",
    "@types/multer": "^2.2.0"
  },
  "author": "Monolith contributors",
  "monolithBuilds": {
    "build": "rimraf dist && vite build && tsc --emitDeclarationOnly"
  }
}
