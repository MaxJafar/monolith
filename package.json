{
  "name": "monolith",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "description": "monolith — a personal workspace for projects, knowledge and connected databases",
  "version": "0.1.11",
  "license": "CC BY-NC-SA 4.0",
  "author": "Monolith contributors",
  "homepage": "https://monolith-site-maxjafars-projects.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaxJafar/monolith.git"
  },
  "workspaces": [
    "./apps/api",
    "./apps/web",
    "./apps/desktop",
    "./apps/site",
    "./packages/*",
    "./modules/*",
    "./locales/*",
    "./tools"
  ],
  "scripts": {
    "site:dev": "pnpm --filter @monolith/site dev",
    "site:build": "node \"tools/build-guard.mjs\" --task site:build",
    "site:check": "pnpm --filter @monolith/site typecheck && pnpm --filter @monolith/site verify",
    "site:test": "playwright test --config apps/site/playwright.config.ts",
    "agent": "node packages/agent-tools/dist/cli.js",
    "mcp": "node packages/agent-tools/dist/cli.js mcp",
    "agent:build": "node \"tools/build-guard.mjs\" --task agent:build",
    "agent:test": "pnpm --filter @monolith/agent-tools test",
    "updater:build": "node \"tools/build-guard.mjs\" --task updater:build",
    "updater:test": "pnpm native go test ./internal/updates",
    "release:preflight": "node tools/release-preflight.mjs",
    "release:downloads": "node tools/release-downloads.mjs",
    "release:version": "node tools/release-version.mjs",
    "release:platform": "node tools/platform-release.mjs",
    "release:addons": "node \"tools/build-guard.mjs\" --task release:addons",
    "release:pack": "tsx tools/release-addons.mts",
    "brand:assets": "node tools/brand-assets.mjs",
    "native": "node tools/native-toolchain.mjs",
    "desktop:bundle": "node \"tools/build-guard.mjs\" --task desktop:bundle",
    "desktop:addons:test": "node \"tools/build-guard.mjs\" --task desktop:addons:test",
    "desktop:dev": "pnpm --dir apps/desktop exec tauri dev",
    "desktop:windows:build": "node \"tools/build-guard.mjs\" --task desktop:windows:build",
    "desktop:windows:test": "node \"tools/build-guard.mjs\" --task desktop:windows:test",
    "gateway:contract": "node tools/gateway-contract.mjs",
    "gateway:dev": "pnpm native go run ./cmd/monolith",
    "gateway:build": "node \"tools/build-guard.mjs\" --task gateway:build",
    "gateway:test": "pnpm native go test ./...",
    "gateway:migrate": "pnpm native go run ./cmd/monolith migrate",
    "editor:types": "node tools/editor-harness/blocksuite-compat.mjs --types",
    "editor:harness": "vite --config tools/editor-harness/vite.config.ts",
    "editor:harness:build": "node \"tools/build-guard.mjs\" --task editor:harness:build",
    "editor:harness:preview": "vite preview --config tools/editor-harness/vite.config.ts --host 127.0.0.1 --port 5185 --strictPort",
    "editor:test": "node \"tools/build-guard.mjs\" --task editor:test",
    "editor:browsers": "playwright install chromium webkit",
    "forge": "pnpm monolith",
    "local:setup": "tsx --tsconfig=./tools/tsconfig.json tools/src/monolith/localDatabase.ts start",
    "local:stop": "tsx --tsconfig=./tools/tsconfig.json tools/src/monolith/localDatabase.ts stop",
    "migrate:pocketbase": "tsx --tsconfig=./tools/tsconfig.json tools/src/monolith/migratePocketBase.ts",
    "agents:worker": "tsx --tsconfig=./tools/tsconfig.json tools/src/monolith/agentWorker.ts",
    "dev": "pnpm monolith dev",
    "build": "node \"tools/build-guard.mjs\" --task build",
    "lint": "prettier --check . && eslint .",
    "fix": "prettier --write ./ && pnpm lint",
    "test": "node \"tools/build-guard.mjs\" --task test",
    "db:push": "pnpm monolith db push",
    "db:generate": "pnpm --filter @monolith/server db:generate",
    "db:migrate": "pnpm --filter @monolith/server db:migrate",
    "postinstall": "node \"tools/build-guard.mjs\" --task postinstall",
    "typecheck": "turbo typecheck",
    "monolith": "tsx --tsconfig=./tools/tsconfig.json tools/src/index.ts",
    "core:check": "node tools/verify-independence.mjs",
    "build:safe": "node tools/build-guard.mjs --",
    "build:guard:test": "node --test --test-concurrency=1 tools/build-guard.test.mjs"
  },
  "keywords": [
    "monolith",
    "workspace",
    "knowledge",
    "projects"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@monolith/configs": "workspace:*",
    "@module-federation/vite": "^1.18.2",
    "@playwright/test": "1.64.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tauri-apps/cli": "2.12.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.21",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/tinycolor2": "^1.4.6",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@typescript-eslint/utils": "8.61.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.7.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.8.0",
    "rimraf": "^5.0.10",
    "turbo": "^2.0.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.31.1",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "webdriverio": "10.0.2"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@module-federation/runtime": "^2.8.0",
    "@tanstack/react-query": "^5.90.2",
    "@uidotdev/usehooks": "^2.4.1",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "drizzle-orm": "1.0.0-rc.4",
    "i18next": "^26.3.6",
    "i18next-http-backend": "^2.7.3",
    "lodash": "^4.17.21",
    "nuqs": "^2.7.1",
    "opentype.js": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.77.0",
    "react-i18next": "^17.0.10",
    "react-router": "^8.2.0",
    "tinycolor2": "^1.6.0",
    "tsx": "^4.23.1",
    "uuid": "^14.0.1",
    "zod": "4.3.5"
  },
  "monolithBuilds": {
    "site:build": "pnpm --filter @monolith/site build",
    "agent:build": "pnpm --filter @monolith/agent-tools build",
    "updater:build": "node tools/build-updater.mjs",
    "release:addons": "node tools/build-release-addons.mjs",
    "desktop:bundle": "pnpm --filter @monolith/desktop build",
    "desktop:addons:test": "vite build --config tools/federation-harness/vite.config.ts && vite build --config tools/federation-harness/vite.config.ts --mode remote && node tools/federation-harness/test.mjs",
    "desktop:windows:build": "pnpm desktop:bundle && pnpm --dir apps/desktop exec tauri build",
    "desktop:windows:test": "pnpm updater:build windows-amd64 && pnpm native cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "gateway:build": "pnpm native go build ./cmd/monolith",
    "editor:harness:build": "vite build --config tools/editor-harness/vite.config.ts",
    "editor:test": "pnpm editor:harness:build && playwright test --config tools/editor-harness/playwright.config.ts",
    "build": "turbo build --filter=\"./packages/*\" && turbo build --continue",
    "test": "turbo test",
    "postinstall": "pnpm --filter \"./packages/*\" --workspace-concurrency=1 --recursive run build"
  }
}
