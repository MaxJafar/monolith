# Copy to env/.env.docker. Use independent random hex values for all four secrets.
# Hex passwords are URL-safe for the Compose database connection strings.
MONOLITH_DB_ADMIN_PASSWORD=
MONOLITH_DB_APP_PASSWORD=
MASTER_KEY=
JWT_SIGNING_KEY=
MONOLITH_HTTP_PORT=8080
PUBLIC_URL=https://your-server.your-tailnet.ts.net
SERVER_NAME=monolith
# An independent random token, used only to create the first account.
BOOTSTRAP_TOKEN=
# Rooms: only your own TURN relay. No public STUN/TURN service is used by default.
# See https://monolith-site-maxjafars-projects.vercel.app/docs/rooms
# and docker/server/rooms-turnserver.conf.example.
ROOMS_TURN_URLS=
ROOMS_TURN_SECRET=

# Fresh deployments can load only core features and download optional packages.
# Keep 0 when upgrading an existing installation until its addons are migrated.
MONOLITH_CORE_ONLY=1
MONOLITH_ADDON_CATALOG_URL=
MONOLITH_ADDON_CATALOG_PUBLIC_KEY=
MONOLITH_ADDON_ADMIN_IDS=
# Place this file in the persistent storage volume AFTER migration verification.
MONOLITH_ADDON_SCHEMA_FILE=

# Main server updater runs on the host, outside the containers it replaces.
# Set URL to http://host.docker.internal:6169 after installing the supervisor.
MONOLITH_UPDATER_URL=
MONOLITH_UPDATER_TOKEN=
MONOLITH_UPDATE_ADMIN_IDS=
